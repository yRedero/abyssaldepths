{
  "multipart": [
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "abyssaldepths:block/gloam_moss",
        "uvlock": true,
        "x": 90
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "abyssaldepths:block/gloam_moss",
        "uvlock": true,
        "x": 270
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "abyssaldepths:block/gloam_moss",
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "abyssaldepths:block/gloam_moss",
        "uvlock": true,
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "abyssaldepths:block/gloam_moss",
        "uvlock": true,
        "y": 270
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "abyssaldepths:block/gloam_moss",
        "uvlock": true,
        "y": 90
      }
    },
    {
      "when": {
        "down": "false",
        "up": "false",
        "north": "false",
        "south": "false",
        "west": "false",
        "east": "false"
      },
      "apply": {
        "model": "abyssaldepths:block/gloam_moss",
        "uvlock": true
      }
